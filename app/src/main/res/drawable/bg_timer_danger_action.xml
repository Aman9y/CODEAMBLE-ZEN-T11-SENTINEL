<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#FFF1F2" /><stroke android:width="1dp" android:color="#DC2626" /><corners android:radius="7dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/white" /><stroke android:width="1dp" android:color="#F87171" /><corners android:radius="7dp" /></shape>
    </item>
</selector>
