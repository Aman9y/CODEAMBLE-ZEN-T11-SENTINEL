<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    tools:context=".ContentFilteringActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Content Filtering"
            app:titleTextColor="@color/neutral_900" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/neutral_900"
                    android:textSize="20sp"
                    tools:text="Aman's Phone" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ready for Private DNS setup."
                    android:textColor="@color/neutral_600"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchFilteringEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Enable filtering policy"
                android:textColor="@color/neutral_900"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Private DNS hostname"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_600"
                app:hintTextColor="@color/primary_600">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPrivateDnsHostname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/neutral_900"
                    android:textSize="15sp"
                    tools:text="abc123.dns.nextdns.io" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Use the Android Private DNS hostname from your DNS provider, for example NextDNS."
                android:textColor="@color/neutral_500"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Blocked Categories"
                android:textColor="@color/neutral_600"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPorn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adult content"
                    android:textColor="@color/neutral_900"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGambling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gambling"
                    android:textColor="@color/neutral_900"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchViolence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Violence and gore"
                    android:textColor="@color/neutral_900"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Search Protections"
                android:textColor="@color/neutral_600"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSafeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Force SafeSearch"
                    android:textColor="@color/neutral_900"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchYouTubeRestricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Restricted Mode"
                    android:textColor="@color/neutral_900"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Custom Block List"
                android:textColor="@color/neutral_600"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Domain to block"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/primary_600"
                    app:hintTextColor="@color/primary_600">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomDomain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/neutral_900"
                        android:textSize="15sp"
                        tools:text="example.com" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddDomain"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Add Domain"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/primary_600"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemoveLastDomain"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Remove Last"
                        android:textAllCaps="false"
                        android:textColor="@color/error_600"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/error_600"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCustomDenylist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_round"
                    android:padding="12dp"
                    android:text="No custom domains added yet."
                    android:textColor="@color/neutral_700"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveFiltering"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="Save Filtering Policy"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="@color/primary_600"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyHostname"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Copy Hostname"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_600"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/primary_600"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenPrivateDns"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Open Settings"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_600"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/primary_600"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
