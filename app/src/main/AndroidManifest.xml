<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Existing permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- This app does not use Android Advertising ID; remove any SDK-merged AD_ID permission. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- New permissions for QR code and app blocking -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        Declare launcher-app discovery explicitly for Android package visibility.
        ChildAppUtils queries ACTION_MAIN + CATEGORY_LAUNCHER to build the app list
        used by parental app selection and usage limits.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Additional permissions for better app blocking -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- New permission for PACKAGE_USAGE_STATS -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Permission for boot completed to start services automatically -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Location permissions for child device tracking -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Permission to request battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".Master2Application"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Master2"
        tools:targetApi="31">

        <meta-data
            android:name="isMonitoringTool"
            android:value="child_monitoring" />

        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <service
            android:name="com.google.firebase.components.ComponentDiscoveryService"
            tools:node="merge">
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.firestore.FirebaseFirestoreKtxRegistrar"
                tools:node="remove" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.database.FirebaseDatabaseKtxRegistrar"
                tools:node="remove" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.FirebaseCommonKtxRegistrar"
                tools:node="remove" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.sessions.FirebaseSessionsRegistrar"
                tools:node="remove" />
        </service>

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Existing activities -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Master2.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full Screen Map Activity -->
        <activity
            android:name=".FullScreenMapActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".LoginTypeActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <!-- ParentLoginActivity REMOVED (Dead Code) -->

        <activity
            android:name=".ParentAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ParentEmailLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ParentSignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ParentSignupPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".OtpVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ParentDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".GuideBookActivity"
            android:exported="false"
            android:label="Guide Book"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".AssistantActivity"
            android:exported="false"
            android:label="Assistant"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ParentSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".InfoDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildNotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".TimerStatusActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <service
            android:name=".services.PermissionMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="permission_monitoring" />
        </service>

          <service
              android:name=".services.PermissionEventListener"
              android:enabled="true"
              android:exported="false"
              android:foregroundServiceType="specialUse">
              <property
                  android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                  android:value="parent_child_permission_alert_delivery" />
          </service>

        <service
            android:name=".services.PackageChangeService"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".LoadingActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildNameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildMonitoringDisclosureActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildPermissionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <!-- DeviceIDCheckActivity REMOVED (Dead Code) -->

        <activity
            android:name=".RoleSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <!-- Override ZXing's default orientation restriction to support Android 16 large screens -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- New activities for QR code and preset functionality -->
        <activity
            android:name=".PresetCreationActivity"
            android:exported="false"
            android:label="Create Focus Mode Preset"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".QRDisplayActivity"
            android:exported="false"
            android:label="QR Code"
            android:theme="@style/Theme.Master2.NoActionBar" />



        <activity
            android:name=".ChildInstalledAppsActivity"
            android:exported="false"
            android:label="Installed Apps"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildDashboardActivity"
            android:exported="false"
            android:label="Child Dashboard"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <!-- SUSAGE-style Usage Activities -->
        <activity
            android:name=".ChildDeviceUsageActivity"
            android:exported="false"
            android:label="Usage Data"
            android:parentActivityName=".ChildDashboardActivity"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".ChildUsageViewActivity"
            android:exported="false"
            android:label="Child Usage"
            android:parentActivityName=".ParentDashboardActivity"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <activity
            android:name=".TermsAndServicesActivity"
            android:exported="false"
            android:label="Terms and Services"
            android:theme="@style/Theme.Master2.NoActionBar" />






        <!-- Duplicate AddTaskActivity removed -->

        <activity
            android:name=".ChildAppListActivity"
            android:exported="false"
            android:label="Child Apps"
            android:theme="@style/Theme.Master2.NoActionBar" />

        <!-- Accessibility Service for App Blocking -->
        <service
            android:name=".BlockService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:enabled="true"
            tools:ignore="RestrictedApi">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Remote Block Monitoring Service -->
        <service
            android:name=".RemoteBlockService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control_and_child_device_monitoring" />
        </service>



        <!-- Per-App Timer Service -->
        <service
            android:name=".services.AppTimerService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_parental_control_app_timer_monitoring" />
        </service>


        <!-- Daily Timer Reset Service -->



        <service
            android:name=".DailyTimerResetService"
            android:exported="false"
            android:enabled="true" />


        <!-- Persistent Connection Service for Child Devices -->
        <service
            android:name=".services.PersistentConnectionService"
            android:exported="false"
            android:enabled="true" />

        <!-- Usage Data Storage Service -->

        <!-- Boot Receiver for automatic service start -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 🛡️ BULLETPROOF: Service Watchdog for auto-restart -->
        <receiver
            android:name=".ServiceWatchdog"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="online.monarchlabs.sentinel.CHECK_SERVICES" />
                <action android:name="online.monarchlabs.sentinel.RESTART_SERVICES" />
            </intent-filter>
        </receiver>

        <!-- 🛡️ DEVICE ADMIN: Uninstall Protection -->
        <receiver
            android:name=".AppDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- 📦 APP STATUS TRACKER: Monitor installations/uninstallations -->
        <receiver
            android:name=".AppInstallUninstallReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>




    </application>

</manifest>
