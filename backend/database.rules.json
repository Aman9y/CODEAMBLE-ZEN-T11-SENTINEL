          ".write": "auth != null && ((!newData.exists() && data.child('parentUid').val() === auth.uid) || (data.exists() && data.child('parentUid').val() === auth.uid && newData.exists() && newData.child('parentUid').val() === auth.uid && newData.child('status').val() === 'removing') || (newData.exists() && newData.child('childAuthUid').val() === auth.uid && newData.child('status').val() === 'active' && root.child('v2/pairing_sessions').child(newData.child('pairingSessionId').val()).child('parentUid').val() === newData.child('parentUid').val() && root.child('v2/pairing_sessions').child(newData.child('pairingSessionId').val()).child('parentDeviceId').isString() && root.child('v2/pairing_sessions').child(newData.child('pairingSessionId').val()).child('baseQRKey').val() === newData.child('pairingKey').val() && root.child('v2/pairing_sessions').child(newData.child('pairingSessionId').val()).child('expiresAt').val() > now && (root.child('v2/pairing_sessions').child(newData.child('pairingSessionId').val()).child('isActive').val() === true || root.child('v2/pairing_sessions').child(newData.child('pairingSessionId').val()).child('status').val() === 'active') && (!data.exists() || data.child('parentUid').val() === newData.child('parentUid').val() || data.child('status').val() === 'stale' || (data.child('lastSeenAt').isNumber() && data.child('lastSeenAt').val() + 7776000000 <= now))))",
          ".validate": "!newData.exists() || (newData.child('parentUid').isString() && newData.child('childAuthUid').isString() && newData.child('connectionId').isString() && newData.child('status').isString() && (!data.exists() || data.child('parentUid').val() === newData.child('parentUid').val() || data.child('status').val() === 'stale' || (data.child('lastSeenAt').isNumber() && data.child('lastSeenAt').val() + 7776000000 <= now)))",
          "lastSeenAt": {
            ".write": "auth != null && (root.child('v2/device_owners').child($deviceId).child('childAuthUid').val() === auth.uid || (!newData.exists() && root.child('v2/device_owners').child($deviceId).child('parentUid').val() === auth.uid))",
            ".validate": "newData.isNumber()"
          }
        }
