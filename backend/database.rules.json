          }
        }
      },
      "pairing_sessions": {
        "$sessionId": {
          ".read": "auth != null && (data.child('parentUid').val() === auth.uid || (data.child('isActive').val() === true && data.child('expiresAt').val() > now))",
          ".write": "auth != null && ((!data.exists() && newData.child('parentUid').val() === auth.uid) || data.child('parentUid').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.child('parentUid').isString() && newData.child('parentDeviceId').isString() && newData.child('baseQRKey').isString() && newData.child('expiresAt').isNumber() && (newData.child('parentUid').val() === auth.uid || newData.child('parentUid').val() === data.child('parentUid').val()))",
